<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Validadores clásicos (no necesitan jQuery) -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <connectionStrings>
    <!-- Data Source = nombre del servidor que aparece al conectarte en SQL Server Management Studio.
         Ejemplos: .   |   .\SQLEXPRESS   |   localhost   |   (localdb)\MSSQLLocalDB   |   NOMBRE-PC\SQLEXPRESS -->
    <add name="conexionDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=EncuentroAcademico;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
  <system.webServer><defaultDocument><files><clear/><add value="Portal.aspx"/><add value="Default.aspx"/></files></defaultDocument></system.webServer>
</configuration>



