<%@ Page Language="C#" AutoEventWireup="true" %>
<%@ Import Namespace="System" %><%@ Import Namespace="System.Data" %><%@ Import Namespace="System.Data.SqlClient" %><%@ Import Namespace="System.Configuration" %><%@ Import Namespace="System.Security.Cryptography" %><%@ Import Namespace="System.Web" %>
<script runat="server">
string cs { get { return ConfigurationManager.ConnectionStrings["conexionDB"].ConnectionString; } }
string tab { get { return Request.QueryString["tab"] ?? "resumen"; } }
void Page_Load(object sender, EventArgs e) { if (Session["usuario"] == null && !IsPostBack && Request.QueryString["salir"] != "1") { pnlLogin.Visible=true; pnlApp.Visible=false; } else if(Request.QueryString["salir"]=="1") { Session.Clear(); Response.Redirect("Portal.aspx"); } else { pnlLogin.Visible=Session["usuario"]==null; pnlApp.Visible=!pnlLogin.Visible; if(pnlApp.Visible) { lblUsuario.Text=Server.HtmlEncode(Convert.ToString(Session["usuario"])); Mostrar(); } } }
void Mostrar(){ pResumen.Visible=tab=="resumen"; pActividades.Visible=tab=="actividades"; pInscripciones.Visible=tab=="inscripciones"; if(pResumen.Visible) { using(var c=new SqlConnection(cs)){c.Open(); lblTotal.Text=Escalar(c,"SELECT COUNT(*) FROM dbo.ActividadAcademica").ToString(); lblEst.Text=Escalar(c,"SELECT COUNT(*) FROM dbo.InscripcionActividad WHERE Estado=N'Confirmada'").ToString(); lblProx.Text=Escalar(c,"SELECT COUNT(*) FROM dbo.ActividadAcademica WHERE FechaInicio>=CONVERT(date,GETDATE()) AND Estado<>N'Cancelada'").ToString(); lblFin.Text=Escalar(c,"SELECT COUNT(*) FROM dbo.ActividadAcademica WHERE FechaFin<CONVERT(date,GETDATE())").ToString();} gvResumen.DataSource=Tabla("SELECT TOP 6 a.Titulo,t.Nombre Tipo,a.FechaInicio,a.Modalidad,a.Estado,a.Cupos-ISNULL(i.N,0) Disponibles FROM dbo.ActividadAcademica a JOIN dbo.TipoActividad t ON t.Id=a.TipoId OUTER APPLY(SELECT COUNT(*) N FROM dbo.InscripcionActividad WHERE ActividadId=a.Id AND Estado=N'Confirmada')i ORDER BY a.FechaInicio"); gvResumen.DataBind(); } if(pActividades.Visible){if(!IsPostBack){ddlTipo.DataSource=Tabla("SELECT Id,Nombre FROM dbo.TipoActividad ORDER BY Nombre");ddlTipo.DataTextField="Nombre";ddlTipo.DataValueField="Id";ddlTipo.DataBind();} gvAct.DataSource=Tabla("SELECT a.Id,a.Titulo,t.Nombre Tipo,a.FechaInicio,a.FechaFin,a.HoraInicio,a.HoraFin,a.Modalidad,a.Lugar,a.Cupos,a.Estado FROM dbo.ActividadAcademica a JOIN dbo.TipoActividad t ON t.Id=a.TipoId WHERE a.Titulo LIKE @q ORDER BY a.FechaInicio",new SqlParameter("@q","%"+txtBuscar.Text.Trim()+"%"));gvAct.DataBind();} if(pInscripciones.Visible){if(!IsPostBack){ddlActividad.DataSource=Tabla("SELECT Id,Titulo FROM dbo.ActividadAcademica WHERE Estado<>N'Cancelada' ORDER BY FechaInicio");ddlActividad.DataTextField="Titulo";ddlActividad.DataValueField="Id";ddlActividad.DataBind();ddlEstudiante.DataSource=Tabla("SELECT Idestudiante Id,nombres+' '+apellidos Nombre FROM dbo.Estudiantes ORDER BY nombres");ddlEstudiante.DataTextField="Nombre";ddlEstudiante.DataValueField="Id";ddlEstudiante.DataBind();}gvIns.DataSource=Tabla("SELECT i.Id,a.Titulo Actividad,e.nombres+' '+e.apellidos Estudiante,e.email Correo,i.FechaInscripcion,i.Estado FROM dbo.InscripcionActividad i JOIN dbo.ActividadAcademica a ON a.Id=i.ActividadId JOIN dbo.Estudiantes e ON e.Idestudiante=i.EstudianteId ORDER BY i.Id DESC");gvIns.DataBind();} }
DataTable Tabla(string sql, params SqlParameter[] ps){using(var c=new SqlConnection(cs))using(var d=new SqlDataAdapter(sql,c)){foreach(var p in ps)d.SelectCommand.Parameters.Add(p);var t=new DataTable();d.Fill(t);return t;}}
int Escalar(SqlConnection c,string sql){using(var x=new SqlCommand(sql,c))return Convert.ToInt32(x.ExecuteScalar());}
void Login(object s, EventArgs e){try{using(var c=new SqlConnection(cs))using(var x=new SqlCommand("SELECT Nombre,PasswordHash,Salt,Iteraciones FROM dbo.UsuarioAcceso WHERE Correo=@e AND Activo=1",c)){x.Parameters.AddWithValue("@e",txtCorreo.Text.Trim());c.Open();using(var r=x.ExecuteReader()){if(r.Read()){byte[] expected=(byte[])r["PasswordHash"],salt=(byte[])r["Salt"];int n=Convert.ToInt32(r["Iteraciones"]);byte[] got;using(var k=new Rfc2898DeriveBytes(txtClave.Text,salt,n))got=k.GetBytes(expected.Length);int d=0;for(int i=0;i<got.Length;i++)d|=got[i]^expected[i];if(d==0){Session["usuario"]=r["Nombre"].ToString();Response.Redirect("Portal.aspx?tab=resumen");return;}}}} lblLogin.Text="Correo o contraseña incorrectos.";}catch(Exception){lblLogin.Text="No se pudo conectar con la base de datos. Ejecuta el script SQL y revisa Web.config.";} }
void Buscar(object s,EventArgs e){ Mostrar(); }
void Guardar(object s,EventArgs e){try{if(String.IsNullOrWhiteSpace(txtTitulo.Text)||String.IsNullOrWhiteSpace(txtDesc.Text)||String.IsNullOrWhiteSpace(txtLugar.Text)||Convert.ToInt32(txtCupos.Text)<=0)throw new Exception("Completa los campos y usa cupos mayores que cero.");DateTime fi=DateTime.Parse(txtFecha.Text),ff=DateTime.Parse(txtFechaFin.Text);TimeSpan hi=TimeSpan.Parse(txtHora.Text),hf=TimeSpan.Parse(txtHoraFin.Text);if(ff<fi||hf<=hi)throw new Exception("Revisa el rango de fechas y horas.");using(var c=new SqlConnection(cs))using(var x=new SqlCommand("IF @id=0 INSERT dbo.ActividadAcademica(Titulo,Descripcion,TipoId,FechaInicio,FechaFin,HoraInicio,HoraFin,Modalidad,Lugar,Cupos,Estado) VALUES(@t,@d,@tipo,@fi,@ff,@hi,@hf,@m,@l,@cup,@e) ELSE UPDATE dbo.ActividadAcademica SET Titulo=@t,Descripcion=@d,TipoId=@tipo,FechaInicio=@fi,FechaFin=@ff,HoraInicio=@hi,HoraFin=@hf,Modalidad=@m,Lugar=@l,Cupos=@cup,Estado=@e WHERE Id=@id",c)){x.Parameters.AddWithValue("@id",String.IsNullOrEmpty(txtActId.Text)?0:Convert.ToInt32(txtActId.Text));x.Parameters.AddWithValue("@t",txtTitulo.Text.Trim());x.Parameters.AddWithValue("@d",txtDesc.Text.Trim());x.Parameters.AddWithValue("@tipo",ddlTipo.SelectedValue);x.Parameters.AddWithValue("@fi",fi);x.Parameters.AddWithValue("@ff",ff);x.Parameters.AddWithValue("@hi",hi);x.Parameters.AddWithValue("@hf",hf);x.Parameters.AddWithValue("@m",ddlModalidad.SelectedValue);x.Parameters.AddWithValue("@l",txtLugar.Text.Trim());x.Parameters.AddWithValue("@cup",txtCupos.Text);x.Parameters.AddWithValue("@e",ddlEstado.SelectedValue);c.Open();x.ExecuteNonQuery();}lblMsg.Text="Actividad guardada.";txtActId.Text="";}catch(Exception ex){lblMsg.Text=Server.HtmlEncode(ex.Message);}Mostrar();}
void EditarActividad(object s,EventArgs e){int id=Convert.ToInt32(gvAct.SelectedDataKey.Value);DataTable t=Tabla("SELECT * FROM dbo.ActividadAcademica WHERE Id=@id",new SqlParameter("@id",id));if(t.Rows.Count==0)return;DataRow r=t.Rows[0];txtActId.Text=id.ToString();txtTitulo.Text=r["Titulo"].ToString();txtDesc.Text=r["Descripcion"].ToString();ddlTipo.SelectedValue=r["TipoId"].ToString();txtFecha.Text=Convert.ToDateTime(r["FechaInicio"]).ToString("yyyy-MM-dd");txtFechaFin.Text=Convert.ToDateTime(r["FechaFin"]).ToString("yyyy-MM-dd");txtHora.Text=TimeSpan.Parse(r["HoraInicio"].ToString()).ToString(@"hh\:mm");txtHoraFin.Text=TimeSpan.Parse(r["HoraFin"].ToString()).ToString(@"hh\:mm");ddlModalidad.SelectedValue=r["Modalidad"].ToString();txtLugar.Text=r["Lugar"].ToString();txtCupos.Text=r["Cupos"].ToString();ddlEstado.SelectedValue=r["Estado"].ToString();lblMsg.Text="Editando actividad #"+id;}void BorrarActividad(object s,GridViewDeleteEventArgs e){e.Cancel=true;int id=Convert.ToInt32(gvAct.DataKeys[e.RowIndex].Value);using(var c=new SqlConnection(cs))using(var x=new SqlCommand("UPDATE dbo.ActividadAcademica SET Estado=N'Cancelada' WHERE Id=@id",c)){x.Parameters.AddWithValue("@id",id);c.Open();x.ExecuteNonQuery();}Mostrar();}
void Inscribir(object s,EventArgs e){try{using(var c=new SqlConnection(cs)){c.Open();using(var tx=c.BeginTransaction(IsolationLevel.Serializable)){int act=Convert.ToInt32(ddlActividad.SelectedValue),est=Convert.ToInt32(ddlEstudiante.SelectedValue);using(var x=new SqlCommand("IF EXISTS(SELECT 1 FROM dbo.ActividadAcademica a WHERE a.Id=@a AND a.Estado<>N'Cancelada' AND a.FechaInicio>=CONVERT(date,GETDATE()) AND (SELECT COUNT(*) FROM dbo.InscripcionActividad i WHERE i.ActividadId=a.Id AND i.Estado=N'Confirmada')<a.Cupos) AND NOT EXISTS(SELECT 1 FROM dbo.InscripcionActividad WHERE ActividadId=@a AND EstudianteId=@e AND Estado=N'Confirmada') BEGIN IF EXISTS(SELECT 1 FROM dbo.InscripcionActividad WHERE ActividadId=@a AND EstudianteId=@e) UPDATE dbo.InscripcionActividad SET Estado=N'Confirmada',FechaInscripcion=SYSDATETIME() WHERE ActividadId=@a AND EstudianteId=@e; ELSE INSERT dbo.InscripcionActividad(ActividadId,EstudianteId) VALUES(@a,@e); END; SELECT @@ROWCOUNT",c,tx)){x.Parameters.AddWithValue("@a",act);x.Parameters.AddWithValue("@e",est);if(Convert.ToInt32(x.ExecuteScalar())==0)throw new Exception("Sin cupos, actividad pasada o estudiante ya inscrito.");}tx.Commit();}}lblMsgIns.Text="Estudiante inscrito correctamente.";}catch(Exception ex){lblMsgIns.Text=Server.HtmlEncode(ex.Message);}Mostrar();}
void CancelarIns(object s,GridViewDeleteEventArgs e){e.Cancel=true;using(var c=new SqlConnection(cs))using(var x=new SqlCommand("UPDATE dbo.InscripcionActividad SET Estado=N'Cancelada' WHERE Id=@id",c)){x.Parameters.AddWithValue("@id",gvIns.DataKeys[e.RowIndex].Value);c.Open();x.ExecuteNonQuery();}Mostrar();}
</script>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>UniCampus | Gestión Académica</title><style>
:root{--primary:#17376d;--accent:#ed6a56;--bg:#f1f4fa;--card:#fff;--text:#1d2b45;--muted:#68758c;--line:#e0e6f0;--soft:#e8effb}*{box-sizing:border-box}body{margin:0;font:15px 'Segoe UI',Arial,sans-serif;background:var(--bg);color:var(--text)}header{height:74px;background:var(--primary);color:white;display:flex;align-items:center;justify-content:space-between;padding:0 5%;box-shadow:0 4px 16px #15284933}.brand{font-size:23px;font-weight:750}.brand small{display:block;font-size:12px;font-weight:400;opacity:.8}.user{font-size:14px}.wrap{max-width:1360px;margin:32px auto;padding:0 24px}.nav{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.nav h1{margin:0;font-size:28px;color:var(--primary)}details{position:relative}summary,.btn{cursor:pointer;border:0;border-radius:9px;padding:11px 16px;background:var(--primary);color:white;font-weight:650}details nav{position:absolute;z-index:10;right:0;top:44px;width:230px;background:white;border:1px solid var(--line);border-radius:12px;padding:8px;box-shadow:0 12px 30px #18294722}details nav a{display:block;color:var(--text);text-decoration:none;padding:11px;border-radius:8px}details nav a:hover{background:var(--soft);color:var(--primary)}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:21px;box-shadow:0 4px 16px #192e4d08;margin-bottom:18px}.stat{font-size:32px;font-weight:750;color:var(--primary);margin:7px 0}.muted{color:var(--muted)}h2{font-size:18px;margin:0 0 18px}.formgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.field label{display:block;font-size:12px;font-weight:700;margin:0 0 6px;color:#41516c}.field input,.field textarea,.field select{width:100%;border:1px solid #cfd7e4;border-radius:8px;padding:10px;font:inherit;background:#fff}.field textarea{min-height:75px}.wide{grid-column:span 2}.btn{background:var(--accent);margin-top:14px}.btn.blue{background:var(--primary)}.msg{display:block;color:#148153;font-weight:700;margin-top:10px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line)}th{background:#f3f6fb;color:#41516c}input[type=submit]{cursor:pointer}.login{max-width:440px;margin:8vh auto}.login .field{margin:14px 0}.login h1{color:var(--primary)}@media(max-width:850px){.grid{grid-template-columns:repeat(2,1fr)}.formgrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:580px){.grid,.formgrid{grid-template-columns:1fr}.wide{grid-column:auto}.wrap{padding:0 12px}.nav h1{font-size:22px}}
</style></head><body><form id="form1" runat="server"><asp:Panel ID="pnlLogin" runat="server" CssClass="card login"><div class="brand" style="color:var(--primary)">UniCampus<small>Sistema de Gestión Académica</small></div><h1>Iniciar sesión</h1><p class="muted">Ingresa para administrar actividades e inscripciones.</p><div class="field"><label>Correo institucional</label><asp:TextBox ID="txtCorreo" runat="server" Text="admin@unicampus.edu" /></div><div class="field"><label>Contraseña</label><asp:TextBox ID="txtClave" runat="server" TextMode="Password" /></div><asp:Button runat="server" Text="Entrar al sistema" CssClass="btn blue" OnClick="Login"/><asp:Label ID="lblLogin" runat="server" CssClass="msg" /></asp:Panel><asp:Panel ID="pnlApp" runat="server"><header><div class="brand">UniCampus<small>Sistema de Gestión Académica</small></div><div class="user">● &nbsp;<asp:Label ID="lblUsuario" runat="server"/> &nbsp;|&nbsp; <a style="color:white" href="Portal.aspx?salir=1">Cerrar sesión</a></div></header><main class="wrap"><div class="nav"><h1>Registro de Actividades Académicas</h1><details><summary>☰ Menú ▾</summary><nav><a href="Portal.aspx?tab=resumen">Resumen general</a><a href="Portal.aspx?tab=actividades">Registro de actividades</a><a href="Portal.aspx?tab=inscripciones">Estudiantes inscritos</a><a href="Default.aspx">Registro de estudiantes</a><a href="Portal.aspx?salir=1">Cerrar sesión</a></nav></details></div>
<asp:Panel ID="pResumen" runat="server"><section class="grid"><div class="card"><div class="muted">Total de actividades</div><div class="stat"><asp:Label ID="lblTotal" runat="server"/></div></div><div class="card"><div class="muted">Estudiantes inscritos</div><div class="stat"><asp:Label ID="lblEst" runat="server"/></div></div><div class="card"><div class="muted">Próximas actividades</div><div class="stat"><asp:Label ID="lblProx" runat="server"/></div></div><div class="card"><div class="muted">Finalizadas</div><div class="stat"><asp:Label ID="lblFin" runat="server"/></div></div></section><section class="card"><h2>Agenda académica</h2><asp:GridView ID="gvResumen" runat="server" AutoGenerateColumns="true" EmptyDataText="Aún no hay actividades registradas." /></section></asp:Panel>
<asp:Panel ID="pActividades" runat="server"><section class="card"><h2>Nueva actividad académica</h2><asp:TextBox ID="txtActId" runat="server" style="display:none"/><div class="formgrid"><div class="field"><label>Título *</label><asp:TextBox ID="txtTitulo" runat="server" MaxLength="150" /></div><div class="field"><label>Tipo de actividad *</label><asp:DropDownList ID="ddlTipo" runat="server"/></div><div class="field"><label>Modalidad *</label><asp:DropDownList ID="ddlModalidad" runat="server"><asp:ListItem>Presencial</asp:ListItem><asp:ListItem>Virtual</asp:ListItem><asp:ListItem>Híbrida</asp:ListItem></asp:DropDownList></div><div class="field wide"><label>Descripción *</label><asp:TextBox ID="txtDesc" runat="server" TextMode="MultiLine" MaxLength="1000"/></div><div class="field"><label>Lugar / enlace *</label><asp:TextBox ID="txtLugar" runat="server" MaxLength="150"/></div><div class="field"><label>Fecha de inicio *</label><asp:TextBox ID="txtFecha" runat="server" TextMode="Date"/></div><div class="field"><label>Fecha de fin *</label><asp:TextBox ID="txtFechaFin" runat="server" TextMode="Date"/></div><div class="field"><label>Hora de inicio *</label><asp:TextBox ID="txtHora" runat="server" TextMode="Time"/></div><div class="field"><label>Hora de fin *</label><asp:TextBox ID="txtHoraFin" runat="server" TextMode="Time"/></div><div class="field"><label>Cupos disponibles *</label><asp:TextBox ID="txtCupos" runat="server" Text="30" TextMode="Number"/></div><div class="field"><label>Estado</label><asp:DropDownList ID="ddlEstado" runat="server"><asp:ListItem>Próxima</asp:ListItem><asp:ListItem>Activa</asp:ListItem><asp:ListItem>Finalizada</asp:ListItem><asp:ListItem>Cancelada</asp:ListItem></asp:DropDownList></div></div><asp:Button runat="server" Text="Guardar actividad" CssClass="btn" OnClick="Guardar"/><asp:Label ID="lblMsg" runat="server" CssClass="msg"/></section><section class="card"><h2>Listado de actividades</h2><asp:TextBox ID="txtBuscar" runat="server" placeholder="Buscar por título"/><asp:Button runat="server" Text="Buscar" CssClass="btn blue" OnClick="Buscar"/><asp:GridView ID="gvAct" runat="server" AutoGenerateColumns="true" DataKeyNames="Id" OnRowDeleting="BorrarActividad" OnSelectedIndexChanged="EditarActividad" EmptyDataText="No hay actividades que mostrar."><Columns><asp:CommandField ShowSelectButton="true" SelectText="Editar"/><asp:CommandField ShowDeleteButton="true" DeleteText="Cancelar actividad"/></Columns></asp:GridView></section></asp:Panel>
<asp:Panel ID="pInscripciones" runat="server"><section class="card"><h2>Inscribir estudiante</h2><div class="formgrid"><div class="field"><label>Actividad *</label><asp:DropDownList ID="ddlActividad" runat="server"/></div><div class="field"><label>Estudiante *</label><asp:DropDownList ID="ddlEstudiante" runat="server"/></div></div><asp:Button runat="server" Text="Confirmar inscripción" CssClass="btn" OnClick="Inscribir"/><asp:Label ID="lblMsgIns" runat="server" CssClass="msg"/></section><section class="card"><h2>Estudiantes inscritos</h2><asp:GridView ID="gvIns" runat="server" AutoGenerateColumns="true" DataKeyNames="Id" OnRowDeleting="CancelarIns" EmptyDataText="Aún no hay inscripciones."><Columns><asp:CommandField ShowDeleteButton="true" DeleteText="Cancelar inscripción"/></Columns></asp:GridView></section></asp:Panel></main></asp:Panel></form></body></html>






